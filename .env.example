# Postgres (Neon, Frankfurt). A workspace's credentials are stored per workspace, sealed, never here.
COLDLYNE_DATABASE_URL=postgres://user:password@host/coldlyne
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Who may sign up while Coldlyne is private, comma-separated.
COLDLYNE_ADMINS=
# A company's own identity provider (any OpenID Connect server). When set, members sign in there and not with Google.
# Redirect address to register with it: <BETTER_AUTH_URL>/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Its name on the sign-in page.
OIDC_NAME=
# Addresses and passwords, unless a company's provider is set. Needs RESEND_API_KEY: a mailed link proves each address.
COLDLYNE_PASSWORD_SIGN_IN=false
# Google's OAuth app: sign-in unless a company's provider is set, and the Gmail, Calendar, Sheets and Postmaster connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft's (Entra ID) app: the Outlook mailbox and calendar connections.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# openssl rand -base64 32: seals every connection's credentials. Keep it safe: without it they can't be opened.
COLDLYNE_SECRETS_KEY=
# Coldlyne's own mail (alerts, sign-in links), through Resend. Never prospecting.
RESEND_API_KEY=
COLDLYNE_MAIL_FROM=Coldlyne <contact@coldlyne.com>
# Vercel cron calls /api/cron/sync with this bearer.
CRON_SECRET=
